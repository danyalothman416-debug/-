  /**
   * Reload current Firebase user to verify if they have clicked the link
   */
  public static async checkEmailVerification(): Promise<{ verified: boolean; user?: UserAccount; error?: string }> {
    const currentFbUser = auth.currentUser;
    if (!currentFbUser) {
      return { verified: false, error: 'هیچ بەکارهێنەرێک نەدۆزرایەوە / No authenticated user found.' };
    }

    try {
      await currentFbUser.reload();
      if (currentFbUser.emailVerified) {
        // Update Firestore
        try {
          await updateDoc(doc(db, 'users', currentFbUser.uid), {
            emailVerified: true,
            updatedAt: new Date().toISOString()
          });
        } catch (e) {
          console.warn('Could not update Firestore emailVerified:', e);
        }

        const userAccount: UserAccount = {
          id: currentFbUser.uid,
          name: currentFbUser.displayName || 'Doctor',
          email: currentFbUser.email || '',
          emailVerified: true,
          quizScore: 0,
          streakDays: 1,
          casesSolved: 0,
          createdAt: new Date().toISOString(),
          avatarColor: 'from-cyan-500 to-blue-600',
        };

        return { verified: true, user: userAccount };
      }
      return { verified: false };
    } catch (err: any) {
      return { verified: false, error: err?.message || 'Failed to check verification.' };
    }
  }

  /**
   * Resend the verification link and generate a fresh 6-digit code
   */
  public static async resendVerificationEmail(targetEmail?: string, existingCode?: string): Promise<{ success: boolean; verificationCode?: string; error?: string }> {
    const currentFbUser = auth.currentUser;
    const emailToUse = (targetEmail || currentFbUser?.email || '').trim().toLowerCase();

    const newCode = existingCode || Math.floor(100000 + Math.random() * 900000).toString();
    if (emailToUse) {
      localStorage.setItem('dr_danyal_code_' + emailToUse, newCode);
    }

    if (currentFbUser) {
      try {
        await sendEmailVerification(currentFbUser);
        await updateDoc(doc(db, 'users', currentFbUser.uid), {
          verificationCode: newCode,
          codeExpiresAt: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(),
        });
      } catch (err: any) {
        console.warn('Notice sending verification email:', err?.message);
      }

      // Send verification email directly via EmailJS in the browser if not already sent
      if (!existingCode) {
        try {
          await dispatchEmailJSVerification(emailToUse, newCode);
        } catch (ejsErr) {
          console.log('EmailJS resend note:', ejsErr);
        }
      }

      return { success: true, verificationCode: newCode };
    }

    if (emailToUse) {
      if (!existingCode) {
        try {
          await dispatchEmailJSVerification(emailToUse, newCode);
        } catch (_) {}
      }

      return { success: true, verificationCode: newCode };
    }

    return { success: false, error: 'No user or email available to resend.' };
  }

  /**
   * Request password reset email
   */
  public static async sendPasswordReset(email: string): Promise<{ success: boolean; error?: string }> {
    const trimmed = email.trim().toLowerCase();
    if (!trimmed || !trimmed.includes('@')) {
      return { success: false, error: 'Please enter a valid email address.' };
    }
    try {
      await sendPasswordResetEmail(auth, trimmed);
      return { success: true };
    } catch (err: any) {
      return { success: false, error: err?.message || 'Failed to send password reset.' };
    }
  }

  /**
   * Sign out current user.
   * Clears in-memory sensitive tokens, cached states, and transient local caches.
   */
  public static async logout(): Promise<void> {
    try {
      SecurityService.clearSensitiveMemoryState();
      localStorage.removeItem('dr_danyal_offline_user');
      localStorage.removeItem('dr_danyal_last_user');
      if (Capacitor.isNativePlatform()) {
        try {
          await Promise.race([
            GoogleAuth.signOut(),
            new Promise((resolve) => setTimeout(resolve, 1000))
          ]);
        } catch (nativeSignOutErr) {
          console.warn('Native GoogleAuth.signOut notice:', nativeSignOutErr);
        }
      }
      await Promise.race([
        signOut(auth),
        new Promise((resolve) => setTimeout(resolve, 1500))
      ]);
    } catch (err) {
      console.error('Error during signOut:', err);
    }
  }

  /**
   * Starts a proactive session token refresh timer (every 40 mins) to ensure uninterrupted
   * authenticated sessions for long clinical study blocks.
   */
  public static startProactiveTokenRefresh(): () => void {
    const interval = setInterval(async () => {
      const user = auth.currentUser;
      if (user) {
        try {
          await user.getIdToken(true);
        } catch (err) {
          console.debug('Token proactive refresh notice:', err);
        }
      }
    }, 40 * 60 * 1000);
    return () => clearInterval(interval);
  }

