  /**
   * Permanently saves a solved medical case to Cloud Firestore under users/{userId}/casesHistory/{caseId}
   * and increments casesSolved and quizScore on the root users/{userId} document.
   * Strictly validates that auth.currentUser.uid matches userId.
   */
  public static async saveCompletedCase(
    userId: string,
    caseData: {
      caseId: string;
      caseTitleEn?: string;
      caseTitleKu?: string;
      specialty?: string;
      score?: number;
    }
  ): Promise<{ casesSolved: number; quizScore: number; solvedCaseIds: string[] }> {
    // Security check: validate targeted document ownership
    if (!SecurityService.validateAuthUid(userId)) {
      return { casesSolved: 0, quizScore: 0, solvedCaseIds: [caseData.caseId] };
    }

    try {
      const userRef = doc(db, 'users', userId);
      const userDoc = await getDoc(userRef);
      const existingData = userDoc.exists() ? userDoc.data() : {};

      const currentSolved: string[] = Array.isArray(existingData.solvedCaseIds) ? existingData.solvedCaseIds : [];
      const alreadySolved = currentSolved.includes(caseData.caseId);
      const newSolvedIds = alreadySolved ? currentSolved : [...currentSolved, caseData.caseId];

      const addScore = alreadySolved ? 10 : (caseData.score || 50);
      const newScore = (existingData.quizScore || 0) + addScore;
      const newCasesCount = alreadySolved 
        ? (existingData.casesSolved || currentSolved.length) 
        : (existingData.casesSolved || currentSolved.length) + 1;

      // 1. Update root user doc
      await updateDoc(userRef, {
        quizScore: newScore,
        casesSolved: newCasesCount,
        solvedCaseIds: newSolvedIds,
        updatedAt: new Date().toISOString(),
      });

      // 2. Save individual case history item under subcollection users/{userId}/casesHistory/{caseId}
      const caseHistoryRef = doc(db, 'users', userId, 'casesHistory', caseData.caseId);
      await setDoc(caseHistoryRef, {
        caseId: caseData.caseId,
        completedAt: new Date().toISOString(),
        scoreAwarded: addScore,
        caseTitleEn: caseData.caseTitleEn || '',
        caseTitleKu: caseData.caseTitleKu || '',
        specialty: caseData.specialty || '',
      });

      return {
        casesSolved: newCasesCount,
        quizScore: newScore,
        solvedCaseIds: newSolvedIds,
      };
    } catch (err) {
      console.warn('Could not save completed case to Firestore:', err);
      return {
        casesSolved: 1,
        quizScore: 50,
        solvedCaseIds: [caseData.caseId],
      };
    }
  }

  /**
   * Permanently updates simulator statistics under users/{userId} and records sessions
   * in users/{userId}/simulatorSessions/{sessionId} in Cloud Firestore.
   * Strictly validates that auth.currentUser.uid matches userId.
   */
  public static async recordSimulatorActivity(
    userId: string,
    type: 'osce' | 'symptom_check' | 'lab_scan' | 'resuscitation',
    details?: { title?: string; score?: number; passed?: boolean; notes?: string }
  ): Promise<void> {
    if (!SecurityService.validateAuthUid(userId)) return;

    try {
      const userRef = doc(db, 'users', userId);
      const userDoc = await getDoc(userRef);
      const existing = userDoc.exists() ? (userDoc.data()?.simulatorStats || {}) : {};

      const updatedStats = {
        osceSimulationsCount: (existing.osceSimulationsCount || 0) + (type === 'osce' ? 1 : 0),
        symptomChecksCount: (existing.symptomChecksCount || 0) + (type === 'symptom_check' ? 1 : 0),
        labScansCount: (existing.labScansCount || 0) + (type === 'lab_scan' ? 1 : 0),
        resuscitationsAttempted: (existing.resuscitationsAttempted || 0) + (type === 'resuscitation' ? 1 : 0),
        resuscitationsSaved: (existing.resuscitationsSaved || 0) + (type === 'resuscitation' && details?.passed ? 1 : 0),
        lastActiveAt: new Date().toISOString(),
      };

      await updateDoc(userRef, {
        simulatorStats: updatedStats,
        updatedAt: new Date().toISOString(),
      });

      // Also record session in subcollection
      const sessionId = `${type}_${Date.now()}`;
      const sessionRef = doc(db, 'users', userId, 'simulatorSessions', sessionId);
      await setDoc(sessionRef, {
        id: sessionId,
        type,
        timestamp: new Date().toISOString(),
        title: details?.title || `${type.toUpperCase()} Simulation`,
        score: details?.score ?? null,
        passed: details?.passed ?? null,
        notes: details?.notes || '',
      });
    } catch (err) {
      console.warn('Could not record simulator activity to Firestore:', err);
    }
  }

