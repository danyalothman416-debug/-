        description: 'مۆبایلی بەهێز لەگەڵ کامێرای لایکا و پڕۆسێسەری Snapdragon 8 Gen 3',
        specs: ['6.73" AMOLED', '50MP x3', 'Snapdragon 8 Gen 3', '4880mAh', '256GB'],
        image: 'https://fdn2.gsmarena.com/vv/pics/xiaomi/xiaomi-14-pro-1.jpg',
        stock: 20
    },
    {
        id: 4,
        name: 'گوگڵ پێکسڵ ٨ پرۆ',
        brand: 'Google',
        category: 'google',
        price: 1100000,
        oldPrice: 1200000,
        description: 'مۆبایلی گوگڵ لەگەڵ ئەندڕۆیدی پاك و کامێرای ژیری دەستکرد',
        specs: ['6.7" LTPO OLED', '50MP', 'Tensor G3', '5050mAh', '128GB'],
        image: 'https://fdn2.gsmarena.com/vv/pics/google/google-pixel-8-pro-1.jpg',
        stock: 8
    },
    {
        id: 5,
        name: 'وەن پڵەس ١٢',
        brand: 'OnePlus',
        category: 'oneplus',
        price: 950000,
        oldPrice: 1050000,
        description: 'مۆبایلی خێرا و بەهێز لەگەڵ شاشەی 120Hz و بارگاویکەری خێرا',
        specs: ['6.82" AMOLED', '50MP', 'Snapdragon 8 Gen 3', '5400mAh', '256GB'],
        image: 'https://fdn2.gsmarena.com/vv/pics/oneplus/oneplus-12-1.jpg',
        stock: 10
    },
    {
        id: 6,
        name: 'هواوی P60 پرۆ',
        brand: 'Huawei',
        category: 'huawei',
        price: 750000,
        oldPrice: 850000,
        description: 'مۆبایلی هواوی لەگەڵ کامێرای نایاب و دیزاینی جوان',
        specs: ['6.67" OLED', '48MP', 'Snapdragon 8+ Gen 1', '4815mAh', '256GB'],
        image: 'https://fdn2.gsmarena.com/vv/pics/huawei/huawei-p60-pro-1.jpg',
        stock: 7
    }
];

// سەبەتەی کڕین
let cart = [];
let currentCategory = 'all';

// نیشاندانی بەرهەمەکان
function displayProducts(productsToShow) {
    const grid = document.getElementById('productsGrid');
    grid.innerHTML = '';
    
    productsToShow.forEach(product => {
        const discount = product.oldPrice ? Math.round((1 - product.price/product.oldPrice) * 100) : 0;
        
        grid.innerHTML += `
            <div class="product-card">
                <img src="${product.image}" alt="${product.name}" class="product-image" 
                     onerror="this.src='https://via.placeholder.com/300x300?text=No+Image'">
                <div class="product-info">
                    <div class="product-brand">${product.brand}</div>
                    <div class="product-name">${product.name}</div>
                    <div class="product-description">${product.description}</div>
                    <div class="product-specs">
                        ${product.specs.map(spec => `<span>${spec}</span>`).join('')}
                    </div>
                    <div class="price-section">
                        <div>
                            ${product.oldPrice ? `<span class="old-price">${product.oldPrice.toLocaleString()} د.ع</span>` : ''}
                            <span class="price">${product.price.toLocaleString()} د.ع</span>
                        </div>
                        ${discount > 0 ? `<span class="discount">-${discount}%</span>` : ''}
                    </div>
                    <button class="add-to-cart ${product.stock === 0 ? 'out-of-stock' : ''}" 
                            ${product.stock === 0 ? 'disabled' : ''}
                            onclick="addToCart(${product.id})">
                        ${product.stock > 0 ? '🛒 زیادکردن بۆ سەبەتە' : '❌ تەواو بووە'}
                    </button>
                </div>
            </div>
        `;
    });
}

// فلتیەر بە کەتێگۆری
function filterByCategory(category, btn) {
    currentCategory = category;
    
    // چالاککردنی دوگمە
    document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    
    filterProducts();
}

// گەڕان و فلتیەر
function filterProducts() {
    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    
    let filtered = products;
    
    if (currentCategory !== 'all') {
        filtered = filtered.filter(p => p.category === currentCategory);
    }
    
    if (searchTerm) {
        filtered = filtered.filter(p => 
            p.name.toLowerCase().includes(searchTerm) ||
            p.brand.toLowerCase().includes(searchTerm) ||
            p.description.toLowerCase().includes(searchTerm)
        );
    }
    
    displayProducts(filtered);
}

// زیادکردن بۆ سەبەتە
function addToCart(productId) {
    const product = products.find(p => p.id === productId);
    
    const existingItem = cart.find(item => item.id === productId);
    if (existingItem) {
        existingItem.quantity++;
    } else {
        cart.push({...product, quantity: 1});
    }
    
    updateCartCount();
    showNotification(`${product.name} زیادکرا بۆ سەبەتە ✅`);
}

// نوێکردنەوەی ژمارەی سەبەتە
function updateCartCount() {
    const count = cart.reduce((total, item) => total + item.quantity, 0);
    document.getElementById('cartCount').textContent = count;
}

// کردنەوە و داخستنی سەبەتە
function toggleCart() {
    const modal = document.getElementById('cartModal');
    modal.classList.toggle('active');
    displayCartItems();
}

// نیشاندانی ناوەڕۆکی سەبەتە
function displayCartItems() {
    const cartItems = document.getElementById('cartItems');
    
    if (cart.length === 0) {
        cartItems.innerHTML = '<p style="text-align: center; padding: 30px;">🛒 سەبەتەکەت بەتاڵە</p>';
        document.getElementById('cartTotal').textContent = 'کۆی گشتی: 0 د.ع';
        return;
    }
    
    let html = '';
    let total = 0;
    
    cart.forEach(item => {
        const itemTotal = item.price * item.quantity;
        total += itemTotal;
        
        html += `
            <div class="cart-item">
                <div>
                    <strong>${item.name}</strong><br>
                    <small>${item.quantity} x ${item.price.toLocaleString()} د.ع</small>
                </div>
                <div>
                    <strong>${itemTotal.toLocaleString()} د.ع</strong>
                    <button class="remove-btn" onclick="removeFromCart(${item.id})">🗑️</button>
                </div>
            </div>
        `;
    });
    
    cartItems.innerHTML = html;
    document.getElementById('cartTotal').textContent = `کۆی گشتی: ${total.toLocaleString()} د.ع`;
}

// سڕینەوە لە سەبەتە
function removeFromCart(productId) {
    cart = cart.filter(item => item.id !== productId);
    updateCartCount();
    displayCartItems();
}

// فۆرمی داواکاری
function openCheckout() {
    if (cart.length === 0) {
        showNotification('⚠️ سەبەتەکەت بەتاڵە!');
        return;
    }
    document.getElementById('cartModal').classList.remove('active');
    document.getElementById('checkoutModal').classList.add('active');
}

function closeCheckout() {
    document.getElementById('checkoutModal').classList.remove('active');
}

// ناردنی داواکاری
function submitOrder(event) {
    event.preventDefault();
    
    const name = document.getElementById('customerName').value;
    const phone = document.getElementById('customerPhone').value;
    const city = document.getElementById('customerCity').value;
    const address = document.getElementById('customerAddress').value;
    
    const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    
    // دروستکردنی پەیامی واتساپ
    let message = `📱 داواکاری نوێ%0A%0A`;
    message += `👤 ناو: ${name}%0A`;
    message += `📱 تەلەفۆن: ${phone}%0A`;
    message += `📍 ناونیشان: ${address}، ${city}%0A%0A`;
    message += `🛒 بەرهەمەکان:%0A`;
    
    cart.forEach(item => {
        message += `- ${item.name} (${item.quantity}x)%0A`;
    });
    
    message += `%0A💰 کۆی گشتی: ${total.toLocaleString()} د.ع`;
    
    // کردنەوەی واتساپ
    const whatsappNumber = '9647701234567'; // ژمارەی واتساپی دوکان
    window.open(`https://wa.me/${whatsappNumber}?text=${message}`, '_blank');
    
    // سڕینەوەی سەبەتە
    cart = [];
    updateCartCount();
    document.getElementById('checkoutModal').classList.remove('active');
    
    showNotification('✅ داواکاریت بە سەرکەوتوویی تۆمارکرا! لە واتساپ پەیوەندیت پێوە دەکەین');
    
    // ڕیستارتکردنی فۆرم
    document.getElementById('customerName').value = '';
    document.getElementById('customerPhone').value = '';
    document.getElementById('customerCity').value = '';
    document.getElementById('customerAddress').value = '';
}

// نۆتیفیکەیشن
function showNotification(message) {
    const notification = document.getElementById('notification');
    notification.textContent = message;
    notification.classList.add('show');
    
    setTimeout(() => {
        notification.classList.remove('show');
    }, 3000);
}

// دەستپێکردن
displayProducts(products);
updateCartCount();
</script>

