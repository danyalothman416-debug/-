  /**
   * Update user's profile avatar photo URL and persist across Firestore and local storage.
   */
  public static async updateUserAvatar(
    userId: string,
    photoURL: string
  ): Promise<boolean> {
    if (!SecurityService.validateAuthUid(userId)) return false;

    try {
      // 1. Update Firestore user document
      const userRef = doc(db, 'users', userId);
      await updateDoc(userRef, {
        photoURL,
        updatedAt: new Date().toISOString()
      });

      // 2. Update Firebase Auth profile if current user matches
      if (auth.currentUser && auth.currentUser.uid === userId) {
        try {
          await updateProfile(auth.currentUser, { photoURL });
        } catch (_) {}
      }

      // 3. Update localStorage fallback
      const stored = localStorage.getItem('dr_danyal_offline_user');
      if (stored) {
        try {
          const parsed = JSON.parse(stored);
          parsed.photoURL = photoURL;
          localStorage.setItem('dr_danyal_offline_user', JSON.stringify(parsed));
        } catch (_) {}
      }
      return true;
    } catch (err) {
      console.warn('Could not update user avatar in Firestore:', err);
      // Fallback local persistence
      const stored = localStorage.getItem('dr_danyal_offline_user');
      if (stored) {
        try {
          const parsed = JSON.parse(stored);
          parsed.photoURL = photoURL;
          localStorage.setItem('dr_danyal_offline_user', JSON.stringify(parsed));
        } catch (_) {}
      }
      return false;
    }
  }

  /**
   * Subscribe to Firebase Auth state.
   * STRICT MANDATE: Block unverified users from accessing the app.
   */
  public static onAuthStateChange(callback: (user: UserAccount | null, requiresVerification: boolean) => void): () => void {
    return onAuthStateChanged(auth, async (fbUser: FirebaseUser | null) => {
      if (!fbUser) {
        const stored = localStorage.getItem('dr_danyal_offline_user');
        if (stored) {
          try {
            const parsed = JSON.parse(stored);
            const isVerified = parsed.emailVerified || localStorage.getItem('dr_danyal_verified_' + (parsed.email || '').toLowerCase()) === 'true';
            if (isVerified) {
              callback({ ...parsed, emailVerified: true }, false);
              return;
            } else {
              callback(parsed, true);
              return;
            }
          } catch (_) {}
        }
        callback(null, false);
        return;
      }

      const emailKey = (fbUser.email || '').toLowerCase();
      const isVerifiedByCode = localStorage.getItem('dr_danyal_verified_' + emailKey) === 'true';
      let isVerified = fbUser.emailVerified || isVerifiedByCode;

      if (!isVerified) {
        try {
          const userDoc = await getDoc(doc(db, 'users', fbUser.uid));
          if (userDoc.exists() && userDoc.data()?.emailVerified) {
            isVerified = true;
          }
        } catch (_) {}
      }

      if (!isVerified) {
        callback(
          {
            id: fbUser.uid,
            name: fbUser.displayName || 'Doctor / Student',
            email: fbUser.email || '',
            emailVerified: false,
            quizScore: 0,
            streakDays: 1,
            casesSolved: 0,
            createdAt: new Date().toISOString(),
          },
          true
        );
        return;
      }

      try {
        const userAccount = await AuthService.fetchFullUserProfile(
          fbUser.uid, 
          fbUser.displayName || undefined, 
          fbUser.email || undefined
        );
        callback(userAccount, false);
      } catch (err) {
        console.warn('Error reading user on auth state change:', err);
        callback(
          {
            id: fbUser.uid,
            name: fbUser.displayName || 'Doctor',
            email: fbUser.email || '',
            emailVerified: true,
            quizScore: 0,
            streakDays: 1,
            casesSolved: 0,
            createdAt: new Date().toISOString(),
            avatarColor: 'from-cyan-500 to-blue-600',
          },
          false
        );
      }
    });
  }
