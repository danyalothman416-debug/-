    <button class="cat-btn" onclick="filterByCategory('huawei', this)">📱 هواوی</button>
</div>

<!-- بەرهەمەکان -->
<div class="products-grid" id="productsGrid"></div>

<!-- مۆدالی سەبەتە -->
<div class="cart-modal" id="cartModal">
    <div class="cart-content">
        <button class="close-btn" onclick="toggleCart()">✕</button>
        <h2 style="text-align: center; margin-bottom: 20px;">🛒 سەبەتەی کڕین</h2>
        <div id="cartItems"></div>
        <div class="total" id="cartTotal">کۆی گشتی: 0 د.ع</div>
        <button class="checkout-btn" onclick="openCheckout()">📦 تەواوکردنی داواکاری</button>
    </div>
</div>

<!-- فۆرمی داواکاری -->
<div class="form-modal" id="checkoutModal">
    <div class="form-content">
        <h2 style="text-align: center; margin-bottom: 20px;">📝 زانیاری داواکاری</h2>
        <form onsubmit="submitOrder(event)">
            <label>👤 ناوی تەواو</label>
            <input type="text" id="customerName" required placeholder="ناوی خۆت بنووسە">
            
            <label>📱 ژمارەی تەلەفۆن</label>
            <input type="tel" id="customerPhone" required placeholder="0770-XXX-XXXX">
            
            <label>🏙️ شار</label>
            <select id="customerCity" required>
                <option value="">شار هەڵبژێرە</option>
                <option>سلێمانی</option>
                <option>هەولێر</option>
                <option>دهۆک</option>
                <option>کەرکوک</option>
                <option>بەغداد</option>
            </select>
            
            <label>📍 ناونیشان</label>
            <textarea id="customerAddress" required placeholder="ناونیشانی تەواوت بنووسە" rows="3"></textarea>
            
            <button type="submit" class="checkout-btn" style="margin-top: 20px;">✅ تەواوکردنی داواکاری</button>
            <button type="button" class="remove-btn" style="margin-top: 10px; width: 100%;" onclick="closeCheckout()">🔙 گەڕانەوە</button>
        </form>
    </div>
</div>

<!-- نۆتیفیکەیشن -->
<div class="notification" id="notification"></div>

<!-- دوگمەی واتساپ -->
<a href="https://wa.me/9647701234567" target="_blank" class="whatsapp-btn" title="پەیوەندیمان پێوەبکە">
    💬
</a>

<!-- فووەتەر -->
<div class="footer">
    <p>© 2024 دوکانی مۆبایل. هەموو مافەکان پارێزراون.</p>
    <p>📞 0770-123-4567 | 📧 info@mobileshop.com</p>
    <p>دروستکراوە بە ❤️ لە کوردستان</p>
</div>

