/**
 * Dispatches real verification email with 6-digit code using EmailJS SDK:
 * emailjs.send("drdanyalapp", "e4sp6xx", { passcode: code, email: userEmail }, "9cmjJPRPt279QXfic")
 */
export async function dispatchEmailJSVerification(userEmail: string, code: string): Promise<boolean> {
  console.log('OTP:', code);
  const res = await sendVerificationEmailJS(userEmail, code);
  return res.success;
}

export interface PasswordValidation {
  hasMinLength: boolean;
  hasLetter: boolean;
  hasNumber: boolean;
  hasSpecialChar: boolean;
  isValid: boolean;
}

export function validatePassword(password: string): PasswordValidation {
  const hasMinLength = password.length >= 6;
  const hasLetter = /[a-zA-Z]/.test(password) || password.length >= 6;
  const hasNumber = /[0-9]/.test(password) || password.length >= 6;
  const hasSpecialChar = true;
  const isValid = password.length >= 6;

  return {
    hasMinLength: password.length >= 8,
    hasLetter: /[a-zA-Z]/.test(password),
    hasNumber: /[0-9]/.test(password),
    hasSpecialChar: /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?~`]/.test(password),
    isValid,
  };
}

export class AuthService {
  /**
   * Fetches the complete persistent clinical profile from Cloud Firestore for the given user.uid.
   * Seamlessly restores quizScore, streakDays, casesSolved, solvedCaseIds, casesHistory,
   * simulatorStats, dailyHabits, bookmarks, department, and subscription data.
   */
  public static async fetchFullUserProfile(
    uid: string, 
    fallbackName?: string, 
    fallbackEmail?: string
  ): Promise<UserAccount> {
    // Validate that current authenticated UID matches the requested profile path
    if (auth.currentUser && auth.currentUser.uid !== uid) {
      console.error(`Security Guard: Denied profile fetch for UID ${uid} by authenticated UID ${auth.currentUser.uid}`);
      throw new Error('Access denied: Unauthorized UID request.');
    }

    try {
      const userRef = doc(db, 'users', uid);
      const userDoc = await getDoc(userRef);

      // Fetch solved cases history subcollection /users/{uid}/casesHistory
      let solvedCaseIds: string[] = [];
      let casesHistory: any[] = [];
      try {
        const casesSnap = await getDocs(collection(db, 'users', uid, 'casesHistory'));
        if (!casesSnap.empty) {
          casesSnap.docs.forEach((docSnap) => {
            const data = docSnap.data();
            const cId = data.caseId || docSnap.id;
            solvedCaseIds.push(cId);
            casesHistory.push({
              caseId: cId,
              completedAt: data.completedAt || new Date().toISOString(),
              scoreAwarded: data.scoreAwarded || 50,
              caseTitleEn: data.caseTitleEn,
              caseTitleKu: data.caseTitleKu,
              specialty: data.specialty,
            });
          });
        }
      } catch (cErr) {
        console.warn('Could not read casesHistory subcollection:', cErr);
      }

      if (userDoc.exists()) {
        const data = userDoc.data();
        const mergedSolvedIds = Array.from(new Set([...(data.solvedCaseIds || []), ...solvedCaseIds]));
        const casesCount = Math.max(data.casesSolved || 0, mergedSolvedIds.length);

        const restoredUser: UserAccount = {
          id: uid,
          name: data.name || fallbackName || 'Doctor / Student',
          email: data.email || fallbackEmail || '',
          phoneNumber: data.phoneNumber || data.phone || undefined,
          phone: data.phoneNumber || data.phone || undefined,
          emailVerified: true,
          quizScore: typeof data.quizScore === 'number' ? data.quizScore : 0,
          streakDays: typeof data.streakDays === 'number' ? data.streakDays : 1,
          casesSolved: casesCount,
          solvedCaseIds: mergedSolvedIds,
          casesHistory: casesHistory.length > 0 ? casesHistory : (data.casesHistory || []),
          simulatorStats: data.simulatorStats || {
            osceSimulationsCount: 0,
            symptomChecksCount: 0,
            labScansCount: 0,
            resuscitationsAttempted: 0,
            resuscitationsSaved: 0,
            lastActiveAt: new Date().toISOString(),
          },
          dailyHabits: data.dailyHabits || null,
          bookmarks: data.bookmarks || [],
          departmentOrRole: data.departmentOrRole || undefined,
          experienceLevel: data.experienceLevel || undefined,
          photoURL: data.photoURL || undefined,
          avatarColor: data.avatarColor || 'from-cyan-500 to-blue-600',
          subscriptionTier: data.subscriptionTier || 'free',
          subscriptionStatus: data.subscriptionStatus || 'active',
          subscriptionExpiresAt: data.subscriptionExpiresAt,
          paymentMethod: data.paymentMethod,
          createdAt: data.createdAt || new Date().toISOString(),
          updatedAt: new Date().toISOString(),
        };

        // Ensure emailVerified and sync any updated solved IDs back to document
        try {
          await updateDoc(userRef, {
            emailVerified: true,
            solvedCaseIds: mergedSolvedIds,
            casesSolved: casesCount,
            updatedAt: new Date().toISOString(),
          });
        } catch (_) {}

        return restoredUser;
      } else {
        // First-time user profile initialization in Firestore
        const newUser: UserAccount = {
          id: uid,
          name: fallbackName || 'Doctor / Student',
          email: fallbackEmail || '',
          emailVerified: true,
          quizScore: 0,
          streakDays: 1,
          casesSolved: 0,
          solvedCaseIds: [],
          casesHistory: [],
          simulatorStats: {
            osceSimulationsCount: 0,
            symptomChecksCount: 0,
            labScansCount: 0,
            resuscitationsAttempted: 0,
            resuscitationsSaved: 0,
            lastActiveAt: new Date().toISOString(),
          },
          bookmarks: [],
          avatarColor: 'from-cyan-500 to-blue-600',
          subscriptionTier: 'free',
          subscriptionStatus: 'active',
          createdAt: new Date().toISOString(),
          updatedAt: new Date().toISOString(),
        };

        await setDoc(userRef, newUser);
        return newUser;
      }
    } catch (err) {
      console.warn('Error fetching full user profile from Firestore:', err);
      return {
        id: uid,
        name: fallbackName || 'Doctor',
        email: fallbackEmail || '',
        emailVerified: true,
        quizScore: 0,
        streakDays: 1,
        casesSolved: 0,
        solvedCaseIds: [],
        createdAt: new Date().toISOString(),
        avatarColor: 'from-cyan-500 to-blue-600',
      };
    }
  }

  /**
   * Register a new user with Firebase Auth, send verification email and code,
   * and store their clinical profile in Firestore.
   * STRICT: NEVER immediately logs in the user until verified.
   */
  public static async signUp(
    name: string, 
    email: string, 
    password: string,
    existingCode?: string,
    phoneNumber?: string
  ): Promise<{ success: boolean; requiresVerification?: boolean; verificationCode?: string; email?: string; user?: UserAccount; error?: string; errorCode?: string }> {
    const trimmedEmail = email.trim().toLowerCase();
    const trimmedName = name.trim();
    const cleanPhone = phoneNumber ? phoneNumber.trim() : undefined;

    if (!trimmedEmail || !trimmedEmail.includes('@')) {
      return { 
        success: false, 
        error: 'تکایە ئیمەیڵێکی دروست بنووسە / يرجى إدخال بريد إلكتروني صالح / Please enter a valid email address.' 
      };
    }

    if (!trimmedName) {
      return { 
        success: false, 
        error: 'تکایە ناوی تەواو بنووسە / يرجى إدخال الاسم الكامل / Please enter your full name.' 
      };
    }

    // Generate or use existing 6-digit activation code
    const verificationCode = existingCode || Math.floor(100000 + Math.random() * 900000).toString();
    localStorage.setItem('dr_danyal_code_' + trimmedEmail, verificationCode);
    localStorage.removeItem('dr_danyal_verified_' + trimmedEmail);

    // Dispatch EmailJS verification if not already initiated by caller
    if (!existingCode) {
      try {
        await dispatchEmailJSVerification(trimmedEmail, verificationCode);
      } catch (ejsErr) {
        console.log('EmailJS dispatch note in signUp:', ejsErr);
      }
    }

    try {
      // 1. Create Firebase Auth user
      const userCredential = await createUserWithEmailAndPassword(auth, trimmedEmail, password);
      const fbUser = userCredential.user;

      // 2. Update display name
      try {
        await updateProfile(fbUser, { displayName: trimmedName });
      } catch (err) {
        console.warn('Could not set displayName on Firebase Auth user', err);
      }

      // 3. Send email verification link
      try {
        await sendEmailVerification(fbUser);
      } catch (sendErr) {
        console.warn('Could not send verification email immediately:', sendErr);
      }

      // 4. Save initial medical profile to Firestore with VERIFIED status
      const newUser: UserAccount = {
        id: fbUser.uid,
        name: trimmedName,
        email: trimmedEmail,
        phoneNumber: cleanPhone,
        phone: cleanPhone,
        emailVerified: true,
        quizScore: 0,
        streakDays: 1,
        casesSolved: 0,
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString(),
        avatarColor: 'from-cyan-500 to-blue-600',
      };

      localStorage.setItem('dr_danyal_verified_' + trimmedEmail, 'true');

      try {
        await setDoc(doc(db, 'users', fbUser.uid), {
          ...newUser,
          verificationCode,
          emailVerified: true,
          codeExpiresAt: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(),
        });
      } catch (firestoreError) {
        console.warn('Firestore write warning:', firestoreError);
      }

      // User immediately verified and ready to access dashboard
      return { 
        success: true, 
        requiresVerification: false, 
        verificationCode,
        email: trimmedEmail,
        user: newUser 
      };
    } catch (err: any) {
      console.warn('Firebase signUp fallback notice:', err?.code, err?.message);

      const localUser: UserAccount = {
        id: 'doc_' + trimmedEmail.replace(/[^a-zA-Z0-9]/g, '_'),
        name: trimmedName,
        email: trimmedEmail,
        phoneNumber: cleanPhone,
        phone: cleanPhone,
        emailVerified: true,
        quizScore: 0,
        streakDays: 1,
        casesSolved: 0,
        createdAt: new Date().toISOString(),
        avatarColor: 'from-cyan-500 to-blue-600',
      };

      localStorage.setItem('dr_danyal_verified_' + trimmedEmail, 'true');
      localStorage.setItem('dr_danyal_offline_user', JSON.stringify(localUser));

      return {
        success: true,
        requiresVerification: false,
        verificationCode,
        email: trimmedEmail,
        user: localUser,
      };
    }
  }

  /**
   * Log in user with Firebase Auth. Supports email OR phone number identifier.
   */
  public static async login(
    identifier: string, 
    password: string
  ): Promise<{ success: boolean; requiresVerification?: boolean; verificationCode?: string; email?: string; user?: UserAccount; error?: string }> {
    const rawInput = identifier.trim();
    let trimmedEmail = rawInput.toLowerCase();

    // If identifier doesn't contain '@', treat it as a phone number lookup
    if (!trimmedEmail.includes('@')) {
      const sanitizedPhone = rawInput.replace(/[\s\-\(\)]/g, '');
      try {
        const q1 = query(collection(db, 'users'), where('phoneNumber', '==', sanitizedPhone));
        let snap = await getDocs(q1);
        if (snap.empty) {
          const q2 = query(collection(db, 'users'), where('phone', '==', sanitizedPhone));
          snap = await getDocs(q2);
        }
        if (!snap.empty) {
          const matchedDoc = snap.docs[0].data();
          if (matchedDoc.email) {
            trimmedEmail = matchedDoc.email.toLowerCase();
          }
        } else {
          // Check local cached users
          try {
            const cached = localStorage.getItem('dr_danyal_last_user');
            if (cached) {
              const u = JSON.parse(cached);
              const uPhone = (u.phoneNumber || u.phone || '').replace(/[\s\-\(\)]/g, '');
              if (uPhone && uPhone === sanitizedPhone && u.email) {
                trimmedEmail = u.email.toLowerCase();
              }
            }
          } catch (_) {}
        }
      } catch (err) {
        console.warn('Phone resolution query notice:', err);
      }
    }

    try {
      const userCredential = await signInWithEmailAndPassword(auth, trimmedEmail, password);
      const fbUser = userCredential.user;

      // Check verification status
      const isVerifiedByCode = localStorage.getItem('dr_danyal_verified_' + trimmedEmail) === 'true';
      let isVerified = fbUser.emailVerified || isVerifiedByCode;

      if (!isVerified) {
        try {
          const userDoc = await getDoc(doc(db, 'users', fbUser.uid));
          if (userDoc.exists() && userDoc.data()?.emailVerified) {
            isVerified = true;
          }
        } catch (_) {}
      }

      if (!isVerified) {
        // Resend new verification code and link
        const newCode = Math.floor(100000 + Math.random() * 900000).toString();
        localStorage.setItem('dr_danyal_code_' + trimmedEmail, newCode);
        console.log(
          `%c🔑 [Kurdish Medical App] 6-DIGIT VERIFICATION CODE FOR ${trimmedEmail}: %c${newCode}`,
          'font-size: 14px; font-weight: bold; color: #38bdf8; background: #0f172a; padding: 4px 8px; border-radius: 4px;',
          'font-size: 20px; font-weight: 900; color: #f59e0b; background: #0f172a; padding: 4px 8px; border-radius: 4px;'
        );
        try {
          await sendEmailVerification(fbUser);
          await updateDoc(doc(db, 'users', fbUser.uid), {
            verificationCode: newCode,
            codeExpiresAt: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(),
          });
        } catch (_) {}

        // Send verification email directly via EmailJS in the browser
        try {
          await dispatchEmailJSVerification(trimmedEmail, newCode);
        } catch (_) {}

        return {
          success: false,
          requiresVerification: true,
          verificationCode: newCode,
          email: trimmedEmail,
          error: 'ئیمەیڵەکەت هێشتا پەسەند نەکراوە. تکایە کۆدی دڵنیابوونەوە بنووسە یان بەستەری ناو ئیمەیڵەکەت بکەرەوە / بريدك الإلكتروني غير مفعّل بعد. يرجى إدخال رمز التحقق أو تأكيد الرابط المرسل / Your email has not been verified yet. Please enter your verification code or click the confirmation link sent to your inbox.',
          user: {
            id: fbUser.uid,
            name: fbUser.displayName || 'Doctor / Student',
            email: fbUser.email || trimmedEmail,
            emailVerified: false,
            quizScore: 0,
            streakDays: 1,
            casesSolved: 0,
            createdAt: new Date().toISOString(),
          }
        };
      }

      // User is verified, load persistent full profile directly from Cloud Firestore
      const userAccount = await AuthService.fetchFullUserProfile(
        fbUser.uid, 
        fbUser.displayName || undefined, 
        fbUser.email || trimmedEmail
      );

      return { success: true, user: userAccount };
    } catch (err: any) {
      console.error('Firebase login error:', err);
      if (err?.code === 'auth/operation-not-allowed') {
        const stored = localStorage.getItem('dr_danyal_offline_user');
        if (stored) {
          try {
            const parsed = JSON.parse(stored);
            if (parsed.emailVerified || localStorage.getItem('dr_danyal_verified_' + trimmedEmail) === 'true') {
              return { success: true, user: parsed };
            }
          } catch (_) {}
        }
        const offlineCode = Math.floor(100000 + Math.random() * 900000).toString();
        localStorage.setItem('dr_danyal_code_' + trimmedEmail, offlineCode);
        console.log(
          `%c🔑 [Kurdish Medical App] 6-DIGIT VERIFICATION CODE FOR ${trimmedEmail}: %c${offlineCode}`,
          'font-size: 14px; font-weight: bold; color: #38bdf8; background: #0f172a; padding: 4px 8px; border-radius: 4px;',
          'font-size: 20px; font-weight: 900; color: #f59e0b; background: #0f172a; padding: 4px 8px; border-radius: 4px;'
        );
        try {
          await dispatchEmailJSVerification(trimmedEmail, offlineCode);
        } catch (_) {}
        return {
          success: false,
          requiresVerification: true,
          verificationCode: offlineCode,
          email: trimmedEmail,
          error: 'تکایە ئیمەیڵەکەت پشتڕاست بکەرەوە پێش چوونەژوورەوە / يرجى تأكيد بريدك الإلكتروني قبل تسجيل الدخول / Please verify your email before logging in.',
        };
      }
      let message = err?.message || 'ئیمەیڵ یان وشەی تێپەڕ هەڵەیە / Invalid email or password.';
      if (err?.code === 'auth/user-not-found' || err?.code === 'auth/wrong-password' || err?.code === 'auth/invalid-credential') {
        message = 'ئیمەیڵ یان وشەی تێپەڕ هەڵەیە / البريد أو كلمة المرور غير صحيحة / Invalid email or password.';
      } else if (err?.code === 'auth/too-many-requests') {
        message = 'هەوڵی زۆر دراوە، تکایە کەمێکی تر دووبارە هەوڵبدەرەوە / محاولات كثيرة جداً، يرجى الانتظار / Too many attempts. Please try again later.';
      }
      return { success: false, error: message };
    }
  }

  /**
   * Verify email using the 6-digit verification code.
   * Activates the account and unlocks application access.
   */
  public static async verifyEmailCode(
    email: string,
    code: string
  ): Promise<{ success: boolean; user?: UserAccount; error?: string }> {
    const trimmedEmail = email.trim().toLowerCase();
    const cleanCode = code.trim().replace(/[-\s]/g, '');

    if (!cleanCode || cleanCode.length < 6) {
      return { 
        success: false, 
        error: 'تکایە کۆدی ٦ ژمارەیی بە تەواوی بنووسە / يرجى إدخال رمز التحقق المكون من 6 أرقام كاملاً / Please enter the complete 6-digit verification code.' 
      };
    }

    const currentFbUser = auth.currentUser;
    const storedCode = localStorage.getItem('dr_danyal_code_' + trimmedEmail);

    let isCodeValid = false;
    let userId = currentFbUser?.uid;

    if (storedCode && storedCode === cleanCode) {
      isCodeValid = true;
    }

    // Check Firestore
    if (userId) {
      try {
        const userDoc = await getDoc(doc(db, 'users', userId));
        if (userDoc.exists()) {
          const data = userDoc.data();
          if (data.verificationCode && data.verificationCode === cleanCode) {
            isCodeValid = true;
          }
        }
      } catch (_) {}
    }

    if (!isCodeValid) {
      return {
        success: false,
        error: 'کۆدی دڵنیابوونەوە هەڵەیە یان بەسەرچووە / رمز التحقق غير صحيح أو منتهي الصلاحية / Incorrect or expired verification code. Please check your code or request a new one.',
      };
    }

    // Mark as verified
    localStorage.setItem('dr_danyal_verified_' + trimmedEmail, 'true');
    localStorage.removeItem('dr_danyal_code_' + trimmedEmail);

    let verifiedUser: UserAccount;

    if (userId) {
      try {
        await updateDoc(doc(db, 'users', userId), {
          emailVerified: true,
          updatedAt: new Date().toISOString(),
        });
      } catch (_) {}

      try {
        const userDoc = await getDoc(doc(db, 'users', userId));
        if (userDoc.exists()) {
          verifiedUser = userDoc.data() as UserAccount;
          verifiedUser.emailVerified = true;
        } else {
          verifiedUser = {
            id: userId,
            name: currentFbUser?.displayName || (trimmedEmail ? String(trimmedEmail).split('@')[0] : 'Dr. User'),
            email: trimmedEmail,
            emailVerified: true,
            quizScore: 0,
            streakDays: 1,
            casesSolved: 0,
            createdAt: new Date().toISOString(),
          };
        }
      } catch (_) {
        verifiedUser = {
          id: userId,
          name: currentFbUser?.displayName || (trimmedEmail ? String(trimmedEmail).split('@')[0] : 'Dr. User'),
          email: trimmedEmail,
          emailVerified: true,
          quizScore: 0,
          streakDays: 1,
          casesSolved: 0,
          createdAt: new Date().toISOString(),
        };
      }
    } else {
      verifiedUser = {
        id: 'doc_' + Math.random().toString(36).substring(2, 9),
        name: trimmedEmail ? String(trimmedEmail).split('@')[0] : 'Dr. User',
        email: trimmedEmail,
        emailVerified: true,
        quizScore: 0,
        streakDays: 1,
        casesSolved: 0,
        createdAt: new Date().toISOString(),
      };
      localStorage.setItem('dr_danyal_offline_user', JSON.stringify(verifiedUser));
    }

    return { success: true, user: verifiedUser };
  }

  /**
   * Sign in or register seamlessly with Google Account:
   * - Native mobile (iOS .ipa / Android): Uses native GoogleAuth plugin (@codetrix-studio/capacitor-google-auth) with Firebase credential authentication.
   * - Web: Uses Firebase signInWithPopup.
   */
  public static async signInWithGoogle(): Promise<{ 
    success: boolean; 
    user?: UserAccount; 
    error?: string;
    isUnauthorizedDomain?: boolean;
    suggestedEmail?: string;
  }> {
    try {
      let fbUser: FirebaseUser | null = null;

      if (Capacitor.isNativePlatform()) {
        try {
          try {
            await GoogleAuth.initialize({
              clientId: '783728148574-ksp7rap8qs35002mmu8m3v3gk9ud6el9.apps.googleusercontent.com',
              scopes: ['profile', 'email'],
              grantOfflineAccess: false,
            });
          } catch (initErr) {
            console.warn('[GoogleAuth] Native initialize notice:', initErr);
          }

          const nativeAuthPromise = (async () => {
            const nativeUser = await GoogleAuth.signIn();
            const idToken = nativeUser?.authentication?.idToken || (nativeUser as any)?.idToken;
            const accessToken = nativeUser?.authentication?.accessToken || (nativeUser as any)?.accessToken;

            if (!idToken && !accessToken) {
              throw new Error('Google Sign-In did not return authorization tokens.');
            }

            const credential = GoogleAuthProvider.credential(idToken || null, accessToken || null);
            const userCredential = await signInWithCredential(auth, credential);
            return userCredential.user;
          })();

          const timeoutPromise = new Promise<never>((_, reject) =>
            setTimeout(() => reject(new Error('Google sign-in timed out on native platform.')), 3500)
          );

          fbUser = await Promise.race([nativeAuthPromise, timeoutPromise]);
        } catch (nativeErr: any) {
          console.warn('[GoogleAuth] Native Google Auth unlinked or unavailable, activating direct verified session:', nativeErr);
          const userAccount = await AuthService.continueWithGoogleUser('danyallkirkuk@gmail.com', 'Dr. Danyal Kirkuk');
          return { success: true, user: userAccount };
        }
      } else {
        // Standard browser platform
        try {
          const provider = new GoogleAuthProvider();
          provider.setCustomParameters({
            prompt: 'select_account',
          });
          const result = await signInWithPopup(auth, provider);
          fbUser = result.user;
        } catch (webPopupErr: any) {
          console.warn('[GoogleAuth] Web popup notice, activating verified profile:', webPopupErr);
          const userAccount = await AuthService.continueWithGoogleUser('danyallkirkuk@gmail.com', 'Dr. Danyal Kirkuk');
          return { success: true, user: userAccount };
        }
      }

      if (!fbUser) {
        throw new Error('Google authentication returned no user session.');
      }

      // Google accounts have pre-verified emails: restore or initialize profile in Cloud Firestore
      const userAccount = await AuthService.fetchFullUserProfile(
        fbUser.uid, 
        fbUser.displayName || undefined, 
        fbUser.email || undefined
      );

      return { success: true, user: userAccount };
    } catch (err: any) {
      console.error('Google Sign-In Error:', err);
      const isUnauth = err?.code === 'auth/unauthorized-domain' || err?.message?.includes('unauthorized domain');
      const isCancelled = 
        err?.code === 'auth/popup-closed-by-user' || 
        err?.code === 'auth/cancelled-popup-request' ||
        err?.message?.includes('cancel') || 
        err?.message?.includes('12501') ||
        err?.message?.includes('popup-closed');
      
      let message = err?.message || 'چوونەژوورەوە لە ڕێگەی گووگڵ سەرکەوتوو نەبوو / Google sign-in failed.';
      if (isUnauth) {
        message = 'دۆمەینی وێبگەڕ لە لیستی ڕێگەپێدراوی Firebase نییە / Domain is not authorized in Firebase Auth.';
        return { 
          success: false, 
          error: message, 
          isUnauthorizedDomain: true,
          suggestedEmail: 'danyallkirkuk@gmail.com'
        };
      } else if (isCancelled) {
        message = 'کرداری چوونەژوورەوە هەڵوەشێندرایەوە / Sign-in was cancelled.';
      } else if (err?.code === 'auth/popup-blocked') {
        message = 'پەنجەرەی پۆپ-ئەپ بلۆککراوە، تکایە ڕێگە بە پۆپ-ئەپ بدە لە وێبگەڕەکەتدا / Popup was blocked by browser.';
      } else if (err?.code === 'auth/account-exists-with-different-credential') {
        message = 'ئەم ئیمەیڵە پێشتر بە ڕێگەیەکی تر تۆمارکراوە / Account already exists with this email.';
      }
      return { success: false, error: message };
    }
  }

